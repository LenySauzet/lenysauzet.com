# The assistant. On Vercel, AI Gateway authenticates with the project's OIDC token;
# locally, `vercel env pull` writes it, or set AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
# true shows the assistant in production; false hides it everywhere.
ASK_ENABLED=
# Overrides the model, e.g. anthropic/claude-haiku-5.5.
ASK_MODEL=
# Upstash Redis, for the limit per visitor (the Vercel Marketplace sets the KV_ pair).
KV_REST_API_URL=
KV_REST_API_TOKEN=
